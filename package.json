{
  "name": "agent-revers-browser",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.12.4",
  "type": "module",
  "scripts": {
    "prepare:assets": "node --experimental-strip-types scripts/prepare-assets.mjs",
    "predev": "pnpm prepare:assets",
    "dev": "vite",
    "prebuild": "pnpm prepare:assets",
    "build": "tsc -b && vite build",
    "pretest": "pnpm prepare:assets",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:browser:wav": "node scripts/e2e-browser-wav-runtime.mjs",
    "e2e:browser": "node scripts/e2e-browser-transition.mjs",
    "e2e:browser:map": "node scripts/e2e-browser-all.mjs e2e-browser-map.mjs",
    "e2e:browser:interactions": "node scripts/e2e-browser-level1-interactions.mjs",
    "e2e:browser:columns": "node scripts/e2e-level39-columns.mjs",
    "e2e:browser:scene38": "node scripts/e2e-browser-scene38.mjs",
    "e2e:browser:scc-restored": "node scripts/e2e-browser-scc-restored.mjs",
    "e2e:browser:fault": "node scripts/e2e-browser-fault.mjs",
    "e2e:browser:lora": "node scripts/e2e-browser-all.mjs e2e-browser-lora.mjs",
    "e2e:browser:inventory-combination": "node scripts/e2e-browser-all.mjs e2e-browser-inventory-combination.mjs",
    "e2e:browser:save-load": "node scripts/e2e-browser-all.mjs e2e-browser-save-load.mjs",
    "e2e:browser:save-load-performance": "node scripts/e2e-browser-all.mjs e2e-browser-save-load-performance.mjs",
    "e2e:browser:save-load-ui": "node scripts/e2e-browser-all.mjs e2e-browser-save-load-ui.mjs",
    "e2e:browser:save-state-identities": "node scripts/e2e-browser-all.mjs e2e-browser-save-state-identities.mjs",
    "e2e:browser:hitbox": "node scripts/e2e-browser-all.mjs e2e-browser-hitbox.mjs",
    "e2e:browser:unified-hit": "node scripts/e2e-browser-all.mjs e2e-browser-unified-hit.mjs",
    "e2e:browser:all": "node scripts/e2e-browser-all.mjs",
    "e2e:browser:level39-transitions": "node scripts/e2e-browser-level39-transitions.mjs",
    "e2e:browser:catalog": "node scripts/e2e-browser-catalog.mjs",
    "catalog:report": "node scripts/report-scene-catalog.mjs",
    "extract:assets": "node scripts/extract-assets.mjs",
    "check:assets": "node --experimental-strip-types scripts/check-assets.mjs",
    "prepare:video": "node scripts/prepare-video.mjs",
    "preview": "vite preview",
    "test:tooling": "node --test tests/asset-tooling.test.mjs"
