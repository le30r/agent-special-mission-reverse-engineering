  "dependencies": {
    "pixi.js": "^8.8.1",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/utif": "^3.0.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
